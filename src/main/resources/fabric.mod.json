{
  "schemaVersion": 1,
  "id": "slabbed",
  "version": "${version}",
  "name": "Slabbed",
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.slabbed.Slabbed"
    ],
    "client": [
      "com.slabbed.client.SlabbedClient"
    ]
  },
  "mixins": [
    {
      "config": "slabbed.mixins.json"
    },
    {
      "config": "slabbed.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": ">=0.119.4",
    "minecraft": "~1.21.4"
  }
}
