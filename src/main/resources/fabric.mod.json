{
  "schemaVersion": 1,
  "id": "slabbed",
  "version": "${version}",
  "name": "Slabbed",
  "description": "Places supported blocks directly on slab surfaces using physical half-block cells.",
  "icon": "assets/slabbed/icon.png",
  "license": "GPL-3.0-only",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.slabbed.Slabbed"
    ],
    "client": [
      "com.slabbed.client.SlabbedClient"
    ]
  },
  "mixins": [
    "slabbed.mixins.json",
    {
      "config": "slabbed.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "java": ">=21"
  }
}
