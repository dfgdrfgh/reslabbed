  "forks": [
    {
      "id": "vanillabackport",
      "version": "1.2",
      "file": "VanillaBackport-fabric-1.21.1-1.2.jar",
      "repo": "dfgdrfgh/TrueVanillaBackport",
      "ref": "88761b024b2125f65e777cc6524e5a3677d4498f",
      "kind": "backport",
      "sha256": "9787eb24ac37d331ba9a6fedac17d21e392d6710f8af35286dfe1a8868d1bb9b",
      "artifact": 12319783504
    }
  ],
  "configs": {
    "config/lithium.properties": "mixin.experimental=true",
    "config/moreculling.toml": "version = 1\nenableSodiumMenu = true\ncloudCulling = true\nsignTextCulling = true\nrainCulling = true\ndontCull = []\nuseBlockStateCulling = true\nuseCustomItemFrameRenderer = true\nitemFrameMapCulling = true\nuseItemFrameLOD = true\nitemFrameLODRange = 16\nuseItemFrame3FaceCulling = true\nitemFrame3FaceCullingRange = 2.0\npaintingCulling = true\nleavesCullingMode = \"DEPTH\"\nleavesCullingAmount = 2\nincludeMangroveRoots = true\nendGatewayCulling = true\nbeaconBeamCulling = true\nuseOnModdedBlocksByDefault = true\n\n[modCompatibility]\nminecraft = true\n",
    "config/vanillabackport-client.toml": "\r\n[\"Bundles of Bravery\"]\r\n\t#allow access to all items in a Bundle instead of only the first 12\r\n\tendless_bundle_ui = false\r\n\t#enable modern bundle models\r\n\thas_modern_bundle_models = true\r\n\t#enable modern redstone torch models (also effects repeaters and comparators)\r\n\thas_modern_redstone_torch_models = true\r\n\t#enable modern banner pattern textures\r\n\thas_modern_banner_pattern_textures = true\r\n\r\n[\"Spring to Life\"]\r\n\t#use the legacy spawn egg textures\r\n\tuse_legacy_spawn_eggs = false\r\n\t#use the modern colored wool undercoat for sheep\r\n\tuse_sheep_wool_undercoat = false\r\n\t#enable falling leaves particles\r\n\tfalling_leaves = true\r\n\t#chance for falling leaf particles to appear\r\n\t#Range: 0.0 ~ 1.0\r\n\tfalling_leaves_frequency = 0.01\r\n\r\n[\"Chase the Skies\"]\r\n\t#display player heads instead of colored player markers\r\n\tlocator_display_player_heads = false\r\n\t#display compass targets such as Lodestones and death locations\r\n\tlocator_display_compass_info = false\r\n\t#display cardinal directions [N, S, E, W]\r\n\tlocator_display_cardinal_points = false\r\n\t#enable the Locator Bar; disabling it on your client does not make you invisible on the server\r\n\tenable_locator_bar = true\r\n\t#keep the experience bar and jump bar visible\r\n\tlocator_display_info_bar = false\r\n\t#extend cloud rendering to match your render distance\r\n\textended_cloud_reach = true\r\n\r\n[\"Copper Age\"]\r\n\t#enable End Flash terrain effects\r\n\tend_flash_terrain_visuals = true\r\n\t#enable End Flash sky effects\r\n\tend_flash_sky_visuals = true\r\n\t#enable modern dye textures\r\n\tenable_modern_dye_textures = true\r\n\t#enable a brown palette to render for each dye\r\n\tenable_dye_palettes = true\r\n\r\n[\"Mounts of Mayhem\"]\r\n\t#toggles the modern Zombie Horse texture\r\n\thas_zombie_horse_retexture = true\r\n\r\n[\"Wilderness Bound\"]\r\n\t#enable modern hay bale texture that is aligned with the straw bed\r\n\thas_modern_hay_bale_texture = true\r\n\r\n",
    "config/vanillabackport-common.toml": "\r\n[\"Bundles of Bravery\"]\r\n\t#enable the modern bundle interface and controls\r\n\thas_updated_bundles = true\r\n\t#apply the modern recipe for bundles\r\n\t#Allowed Values: APPEND, REPLACE, IGNORE\r\n\tbundle_recipe = \"APPEND\"\r\n\t#allow bundles to be dyed\r\n\thas_dyeable_bundle_recipe = true\r\n\t#invert the bundle click controls\r\n\tinverted_bundle_controls = false\r\n\t#allow Bundles to generate in Village loot chests\r\n\tbundle_loot = true\r\n\r\n[\"The Garden Awakens\"]\r\n\t#primary color of Creaking Heart trail particles\r\n\tcreaking_particle_color = 6250335\r\n\t#allow Resin to be obtained from Creaking Hearts\r\n\tresin = true\r\n\t#secondary color of Creaking Heart trail particles\r\n\tcreaking_particle_reverse_color = 16545810\r\n\t#allow Creaking Hearts to spawn Creakings during the day\r\n\tdo_creaking_hearts_work_on_day = false\r\n\t#Wandering Traders to offer items from The Garden Awakens\r\n\tpale_trades = true\r\n\t#apply the modern recipe for saddles\r\n\t#Allowed Values: APPEND, REPLACE, IGNORE\r\n\tsaddle_recipe = \"APPEND\"\r\n\t#allow Pale Garden biomes to generate\r\n\tpale_garden = true\r\n\t#allow Resin to generate in Woodland Mansion loot chests\r\n\tresin_loot = true\r\n\t#allow Creakings to spawn from Creaking Hearts\r\n\tcreaking = true\r\n\t#apply the modern recipe for leads\r\n\t#Allowed Values: APPEND, REPLACE, IGNORE\r\n\tlead_recipe = \"APPEND\"\r\n\r\n[\"Spring to Life\"]\r\n\t#allow wolves to have sound variants\r\n\twolf_sound_variants = true\r\n\t#allow Wandering Traders to offer items from Spring to Life\r\n\tspring_trades = true\r\n\t#chance for a cactus to generate with a Cactus Flower\r\n\t#Range: 0.0 ~ 1.0\r\n\tcactus_flower_spawn_chance = 0.25\r\n\t#allow Camels to spawn naturally\r\n\tcamel_spawns = true\r\n\t#global spawn chance for mob variants; use datapacks for per-variant weighting\r\n\t#Range: 0.0 ~ 1.0\r\n\tmob_variants_spawn_chance = 1.0\r\n\t#allow Firefly Bushes to generate\r\n\tfirefly_bushes = true\r\n\t#allow Lodestones to generate in Ruined Portal loot chests\r\n\tlodestone_loot = true\r\n\t#apply the modern recipe for lodestones\r\n\t#Allowed Values: APPEND, REPLACE, IGNORE\r\n\tlodestone_recipe = \"APPEND\"\r\n\t#allow Cactus Flowers to generate\r\n\tcactus_flowers = true\r\n\t#allow Dry Grass to generate\r\n\tdry_grass = true\r\n\t#allow Wildflowers to generate\r\n\twildflowers = true\r\n\t#allow Bushes to generate\r\n\tbushes = true\r\n\t#allow Fallen Trees to generate\r\n\tfallen_trees = true\r\n\t#allow Chicken, Cow, and Pig variants to spawn\r\n\tfarm_animal_variants = true\r\n\t#allow Leaf Litter to generate\r\n\tleaf_litter = true\r\n\r\n[\"Chase the Skies\"]\r\n\t#drop leash connections when using a Firework Rocket boost\r\n\tleash_drop_connections = true\r\n\t#movement speed multiplier for ridden Happy Ghasts\r\n\thappy_ghast_speed_modifier = 1.0\r\n\t#allow Leashes to have the modern physics and interactions\r\n\tmodern_leashes = true\r\n\t#allow Dried Ghasts to be obtainable through Nether Fossils and Piglin bartering\r\n\tdried_ghasts = true\r\n\t#allow Ghasts to drop the Tears music disc\r\n\ttears_music_disc = true\r\n\r\n[\"Hot as Lava\"]\r\n\t#allow Chicken jockeys to drop the Lava Chicken music disc\r\n\tlava_chicken_music_disc = true\r\n\r\n[\"Copper Age\"]\r\n\t#maximum number of items a Copper Golem can carry\r\n\t#Range: > 1\r\n\tgolem_item_carry_amount = 16\r\n\t#allow Copper Horse Armor to generate in loot chests\r\n\thas_copper_horse_armor_loot = true\r\n\t#maximum ticks before a Copper Golem advances to the next weathering stage\r\n\t#Range: > 0\r\n\tgolem_weathering_tick_to = 552000\r\n\t#allow Copper Armor, Weapons and Tools to be obtainable\r\n\thas_copper_toolset = true\r\n\t#minimum ticks before a Copper Golem advances to the next weathering stage\r\n\t#Range: > 0\r\n\tgolem_weathering_tick_from = 504000\r\n\t#allow Copper Golems to be built using a Carved Pumpkin\r\n\thas_copper_golems = true\r\n\t#allow Weathering Lightning Rods to be obtainable\r\n\thas_weathering_lightning_rods = true\r\n\t#allow Copper Nuggets to be obtainable via crafting\r\n\thas_copper_nuggets = true\r\n\r\n[\"Mounts of Mayhem\"]\r\n\t#allow Camel Husks to spawn naturally\r\n\thas_camel_husks = true\r\n\t#chance for a drowned to spawn riding a nautilus\r\n\t#Range: 0.0 ~ 1.0\r\n\tzombie_nautilus_spawn_chance = 0.5\r\n\t#allow Nautilus to spawn naturally\r\n\thas_nautilus = true\r\n\t#allow Zombie Horses to spawn naturally\r\n\thas_zombie_horses = true\r\n\t#allow Parched Skeletons to spawn naturally\r\n\thas_parched_skeletons = true\r\n\t#allow mounts to float while ridden\r\n\tcan_mounts_float_while_ridden = true\r\n\t#allow Nautilus Armor to generate in loot chests\r\n\thas_nautilus_armor_loot = true\r\n\t#allow Spears to be obtainable and allow monsters to spawn holding them\r\n\thas_spears = true\r\n\r\n[\"Chaos Cubed\"]\r\n\t#allow Sulfur Springs to generate in Sulfur Caves\r\n\thas_sulfur_springs = true\r\n\t#allow damaging Sulfur Cube archetypes to deal damage\r\n\tdo_sulfur_cubes_damage = true\r\n\t#allow explosive Sulfur Cube archetypes to explode\r\n\tdo_sulfur_cubes_explode = true\r\n\t#allow Sulfur Cubes to spawn in Sulfur Caves\r\n\thas_sulfur_cubes = true\r\n\t#allow Sulfur Cave biomes to generate\r\n\thas_sulfur_caves = true\r\n\t#allow Potent Sulfur blocks to generate Geysers\r\n\tdo_geysers_erupt = true\r\n\t#allows the Bounce music disc to generate in Abandoned Mineshafts loot chests\r\n\thas_bounce_music_disc = true\r\n\t#allow Wandering Traders to offer items from Chaos Cubed\r\n\tdo_merchant_trade_chaos_cubed_contents = true\r\n\r\n[\"Wilderness Bound\"]\r\n\t#allow Dappled Forest biomes to generate\r\n\thas_dappled_forest = true\r\n\r\n",
    "config/asyncparticles/asyncparticles-mixin.properties": "#safeBlockEntityMap: Boolean. Make 'LevelChunk#blockEntities' thread-safe.\r\n#safeClassInstanceMultiMap: Boolean. Make 'ClassInstanceMultiMap' thread-safe.\r\n#safeLegacyRandomSource: Boolean. Make LegacyRandomSource thread-safe.\r\n#particle$splitTick: Boolean. Enable recursive particle tick.\r\n#particle$noCulling: A comma-separated list of classes extending 'Particle' that should not be culled.\r\n#particle$noLightCache: A comma-separated list of classes extending 'Particle' that should not use the light cache.\r\n#particle$lockRequired: A comma-separated list of classes extending 'Particle' that require a spin lock.\r\n#particle$lockProvider: A comma-separated list of classes extending 'Particle' that provide a spin lock.\r\n#replaceRandom: A comma-separated list of classes that require multithreaded random sources.\r\n#create$contraptionNoParticleCollision: A comma-separated list of classes extending 'AbstractContraptionEntity' that should not collide with particles.\r\n#\r\n#Wed Oct 21 00:34:30 EDT 2026\r\ncreate$contraptionNoParticleCollision=rbasamoyai.createbigcannons.cannon_control.contraption.PitchOrientedContraptionEntity,rbasamoyai.createbigcannons.cannon_control.contraption.AbstractMountedCannonContraption\r\nparticle$lockProvider=yesman.epicfight.client.particle.TrailParticle,yesman.epicfight.client.particle.AbstractTrailParticle,com.lowdragmc.photon.client.gameobject.FXObject\r\nparticle$lockRequired=yesman.epicfight.client.particle.TrailParticle,yesman.epicfight.client.particle.AbstractTrailParticle,com.lowdragmc.photon.client.gameobject.FXObject\r\nparticle$noCulling=com.lowdragmc.photon.client.gameobject.FXObject,net.bettercombat.client.particle.SlashParticle,com.xm666.realisticcruelty.particle.BloodSplatParticle\r\nparticle$noLightCache=dev.shadowsoffire.gateways.client.GatewayParticle,com.chailotl.particular.particles.FireflyParticle,com.lowdragmc.photon.client.gameobject.FXObject,net.diebuddies.minecraft.weather.WeatherParticle\r\npolytone$CompatEnabled=false\r\nreplaceRandom=appeng.client.render.effects.LightningArcFX,appeng.client.render.effects.LightningFX,de.cheaterpaul.fallingleaves.util.LeafUtil\r\nsafeBlockEntityMap=false\r\nsafeClassInstanceMultiMap=false\r\nsafeLegacyRandomSource=true\r\nversion=3\r\n",
    "config/asyncparticles/asyncparticles.json": "{\n  \"version\": 2,\n  \"particle\": {\n    \"particleLimit\": 16384,\n    \"cleanupStrategy\": \"PARALLEL_WITH_TICK\",\n    \"parallelQueueRemoval\": false,\n    \"parallelQueueEviction\": false,\n    \"particleLightCache\": true,\n    \"cullUnderwaterParticleType\": true\n  },\n  \"tick\": {\n    \"animationTickMode\": true,\n    \"particleAsyncMode\": \"SEQUENTIAL\",\n    \"gpuOnlyAsyncParticleTick\": false,\n    \"tickWeatherAsync\": true,\n    \"deferredTextureTick\": true,\n    \"failPerSecLimit\": 5,\n    \"failBehavior\": \"RAISE_CRASH\",\n    \"suppressCME\": false,\n    \"syncAnimationClasses\": [],\n    \"syncParticleClasses\": [\n      \"pigcart.particlerain.particle.BlockDisplayParticle\"\n    ]\n  },\n  \"rendering\": {\n    \"particleCulling\": \"SPHERE\",\n    \"gpuAcceleration\": true,\n    \"appendNewParticlesToRenderer\": true,\n    \"computeExecutionStage\": \"LEVEL_RENDERING\",\n    \"tickRendererOnMainThread\": false,\n    \"cullWeathers\": true\n  },\n  \"valkyrienSkies\": {\n    \"rainEffect\": \"STATIONARY\",\n    \"fixParticleLights\": true\n  },\n  \"sable\": {\n    \"fixParticleLights\": true\n  },\n  \"polytone\": {\n    \"takeover\": true,\n    \"asyncTick\": true,\n    \"gpuOnlyAsyncTick\": false,\n    \"gpuRendering\": true\n  },\n  \"create\": {\n    \"rainEffect\": \"ALWAYS\",\n    \"tickRainBlockingRange\": 16\n  },\n  \"mobile\": {\n    \"multiDrawWorkaround\": true\n  }\n}"
  },
